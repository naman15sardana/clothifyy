{
  "name": "clothifyy-demo-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion source for the Clothifyy demo video",
  "scripts": {
    "preview": "remotion studio src/index.js",
    "render": "remotion render src/index.js ClothifyyDemo out/clothifyy-demo-raw.mp4 --codec=h264 --crf=18",
