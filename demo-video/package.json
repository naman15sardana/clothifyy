    "still": "remotion still src/index.js ClothifyyDemo out/still.png"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.533",
    "@remotion/google-fonts": "^4.0.533",
    "@remotion/transitions": "^4.0.533",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.533"
  }
}
